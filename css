/* Présentation plus compacte */
.hero {
  display: grid;
  grid-template-columns: 280px 1fr;
  align-items: center;
  gap: 50px;

  padding: 50px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 28px;
}

/* Conteneur de la photo */
.hero__photo {
  width: 280px;
  height: 350px;
  border-radius: 18px;
  overflow: hidden;
}

/* La photo reste bien cadrée sans devenir gigantesque */
.portrait {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center 25%;
  border-radius: 18px;
}

/* On retire le gros espacement précédent */
.hero__content {
  padding: 0;
}


/* Version mobile */
@media (max-width: 700px) {
  .hero {
    grid-template-columns: 1fr;
    gap: 30px;
    padding: 25px;
  }

  .hero__photo {
    width: 100%;
    max-width: 280px;
    height: 340px;
    margin: 0 auto;
  }
}
/* Variables : permettent de modifier facilement l'identité visuelle */
:root {
  --background: #f7f6f2;
  --surface: #ffffff;
  --text: #1d1d1b;
  --muted: #686865;
  --accent: #173c35;
  --accent-light: #e4ece9;
  --border: #dddcd6;
  --radius: 18px;
  --max-width: 1120px;
}

/* Reset léger */
* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
}

/* Conteneur général */
.profile {
  width: min(100% - 40px, var(--max-width));
  margin: 0 auto;
  padding: 50px 0 80px;
}

/* ----- En-tête / Présentation ----- */

.hero {
  min-height: 620px;
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 28px;
  overflow: hidden;
}

.hero__photo {
  min-height: 620px;
  background: #ecebe7;
}

.portrait {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 620px;
  object-fit: cover;
  object-position: center;
}

.hero__content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(40px, 7vw, 80px);
}

.eyebrow {
  margin: 0 0 12px;
  color: var(--accent);
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 18px;
  font-size: clamp(2.8rem, 6vw, 5.2rem);
  line-height: 0.95;
  letter-spacing: -0.05em;
}

.subtitle {
  max-width: 600px;
  margin-bottom: 22px;
  font-size: 1.25rem;
  font-weight: 600;
  line-height: 1.45;
}

.intro {
  max-width: 620px;
  color: var(--muted);
}

/* Bouton accessible avec état de focus visible */
.contact-button {
  align-self: flex-start;
  margin-top: 18px;
  padding: 14px 22px;
  border: 2px solid var(--accent);
  border-radius: 999px;
  background: var(--accent);
  color: white;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
  transition:
    background 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease;
}

.contact-button:hover {
  background: transparent;
  color: var(--accent);
  transform: translateY(-2px);
}

.contact-button:focus-visible {
  outline: 3px solid #8ab5aa;
  outline-offset: 4px;
}

.contact-message {
  min-height: 1.5em;
  margin-top: 14px;
  margin-bottom: 0;
  color: var(--accent);
  font-weight: 600;
}


/* ----- Sections ----- */

.section {
  padding: 85px 0 0;
}

.section-heading {
  display: flex;
  align-items: baseline;
  gap: 20px;
  margin-bottom: 30px;
  border-bottom: 1px solid var(--border);
}

.section-number {
  color: var(--muted);
  font-size: 0.8rem;
}

.section h2 {
  margin-bottom: 14px;
  font-size: clamp(2rem, 5vw, 3.5rem);
  letter-spacing: -0.04em;
}


/* ----- Compétences ----- */

.skills-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.skill-card {
  min-height: 250px;
  padding: 26px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}

.skill-number {
  display: block;
  margin-bottom: 45px;
  color: var(--muted);
  font-size: 0.8rem;
}

.skill-card h3 {
  margin-bottom: 12px;
  font-size: 1.15rem;
}

.skill-card p {
  margin-bottom: 0;
  color: var(--muted);
  font-size: 0.95rem;
}


/* ----- Projets ----- */

.projects-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
}

.project-card {
  min-height: 280px;
  padding: clamp(28px, 5vw, 48px);
  border-radius: var(--radius);
  background: var(--accent);
  color: white;
}

.project-card:nth-child(2) {
  background: var(--accent-light);
  color: var(--text);
}

.project-label {
  margin-bottom: 40px;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.75;
}

.project-card h3 {
  margin-bottom: 18px;
  font-size: clamp(1.5rem, 3vw, 2.3rem);
  line-height: 1.15;
}

.project-card p:last-child {
  margin-bottom: 0;
  opacity: 0.85;
}


/* ----- Responsive tablette ----- */

@media (max-width: 900px) {
  .hero {
    grid-template-columns: 1fr;
  }

  .hero__photo,
  .portrait {
    min-height: 500px;
  }

  .skills-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}


/* ----- Responsive mobile ----- */

@media (max-width: 600px) {
  .profile {
    width: min(100% - 24px, var(--max-width));
    padding-top: 12px;
  }

  .hero {
    border-radius: 18px;
  }

  .hero__photo,
  .portrait {
    min-height: 390px;
  }

  .hero__content {
    padding: 32px 24px;
  }

  h1 {
    font-size: 3rem;
  }

  .subtitle {
    font-size: 1.1rem;
  }

  .section {
    padding-top: 60px;
  }

  .skills-grid,
  .projects-grid {
    grid-template-columns: 1fr;
  }

  .skill-card {
    min-height: auto;
  }

  .skill-number {
    margin-bottom: 25px;
  }
}


/* Respecte les préférences d'animation de l'utilisateur */
@media (prefers-reduced-motion: reduce) {
  * {
    scroll-behavior: auto;
    transition: none !important;
  }
}
